# FootballTix Environment Variables Example
# Copy values into your shell environment or IDE Run Configuration.

# JWT Configuration (REQUIRED in production, minimum 64 characters for HS512)
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-64-characters-long
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500

# Google OAuth2 (Optional for local dev)
GOOGLE_CLIENT_ID=

# Midtrans Payment Gateway (Optional for local dev; use Sandbox keys for testing)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
PAYMENT_ALLOW_SIMULATION=false
TRUST_PROXY_HEADERS=false
